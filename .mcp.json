{
  "mcpServers": {
    "n8n": {
      "command": "cmd",
      "args": ["/c", "npx", "-y", "n8n-mcp"],
      "env": {
        "MCP_MODE": "stdio",
        "LOG_LEVEL": "error",
        "DISABLE_CONSOLE_OUTPUT": "true",
        "N8N_API_URL": "https://niffyjade-n8n-free.hf.space",
        "N8N_API_KEY": "${N8N_API_KEY}"
      }
    }
  }
}
